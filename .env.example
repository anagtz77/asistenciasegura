# .env.example  🔒
# 1. Copia este archivo y renómbralo a  .env  (sin "example").
# 2. Llena los valores de TU equipo.
# 3. El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
 
# Llave para firmar la sesión. Pon una frase larga y diferente por equipo.
SECRET_KEY=cambia-esta-frase-por-una-larga-y-secreta
 
# 1 = modo desarrollo (errores detallados y ruta /dev/entrar). En Render va 0.
MODO_DESARROLLO=1
 
# --- Base de datos ---
# Opción A: XAMPP local  -> DB_HOST=localhost  DB_PORT=3306  DB_USER=root  DB_PASSWORD=   (vacío)
# Opción B: Aiven        -> los datos de "Connection information" del servicio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Cada equipo usa la suya: asist_e1, asist_e2 ... asist_e6
DB_NAME=asist_e1
# Solo para Aiven: ruta al archivo ca.pem que se descarga del servicio. Con XAMPP déjalo vacío.
DB_SSL_CA=
 
# --- Clave que manda el ESP32 en el encabezado X-Clave-Dispositivo ---
CLAVE_DISPOSITIVO=clave-de-prueba-esp32
